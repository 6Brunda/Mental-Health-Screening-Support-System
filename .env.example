# Environment variables template
# Copy this file to .env and fill in values if needed
# Never commit the actual .env file

# Application mode: "demo" or "production"
APP_MODE=demo

# Dataset path override (optional)
# DATASET_PATH=data/mental_health_survey.csv

# Random seed for reproducibility
RANDOM_SEED=42

# Streamlit server settings (optional overrides)
# STREAMLIT_SERVER_PORT=8501
